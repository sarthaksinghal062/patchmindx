# ==============================================================================
# PatchMind AI Engine Configuration (.env)
# ==============================================================================

# LLM Provider Credentials (NEVER commit actual secrets)
# Can use OpenAI-compatible endpoint or Gemini API
LLM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Provider Settings
# For OpenAI: https://api.openai.com/v1
# For Ollama: http://localhost:11434/v1
# For vLLM:   http://localhost:8000/v1
LLM_BASE_URL=https://api.openai.com/v1

# Model Selection
# Examples: gpt-4o-mini, gemini-2.5-flash, claude-3-5-sonnet, deepseek-coder
LLM_MODEL=gpt-4o-mini

# Request Timeout (seconds)
LLM_TIMEOUT_SECONDS=45.0

# Offline / Sandbox Mode (Set to true to use deterministic MockLLMClient without API calls)
PATCHMIND_OFFLINE_MODE=false
